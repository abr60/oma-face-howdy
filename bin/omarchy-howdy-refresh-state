#!/bin/bash
#
# face.howdy:refresh-state — refresh world-readable status markers.
#
# Root privileged. Enrollment lives under root-only /etc/howdy/models and the
# IR emitter config under /root/.config; this writes tiny yes/no markers under
# /etc/omarchy/face-howdy/ so the unprivileged GUI can render accurate status
# without password prompts. Called by the wizard after every privileged phase.
#
#   refresh-state        recalc + write enrolled + ir-configured

set -euo pipefail

dir="/etc/omarchy/face-howdy"
state="no"
ir_state="no"

install -d -m 0755 "$dir"
if compgen -G "/etc/howdy/models/*.dat" >/dev/null 2>&1; then
  state="yes"
fi
printf '%s\n' "$state" > "$dir/enrolled"
chmod 0644 "$dir/enrolled"

if compgen -G "/root/.config/linux-enable-ir-emitter*.toml" >/dev/null 2>&1; then
  ir_state="yes"
fi
printf '%s\n' "$ir_state" > "$dir/ir-configured"
chmod 0644 "$dir/ir-configured"

exit 0
