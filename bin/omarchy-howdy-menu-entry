#!/bin/bash

# omarchy:summary=Open the Face Howdy wizard, or clean up its menu row
# omarchy:group=security
#
# Companion to the face.howdy plugin's menu row. It is copied into the user
# config (~/.config/omarchy/extensions/) when the plugin installs its row, so
# it keeps working after the plugin is disabled or removed. With the plugin
# enabled it opens the wizard window; otherwise it takes the stale setup >
# security > Face Howdy row back out of the user menu extension.

set -euo pipefail

if [[ $EUID -eq 0 && -z "${FACE_HOWDY_ALLOW_ROOT:-}" ]]; then
  echo "ERROR: $0 must not run as root" >&2; exit 1
fi

PLUGIN_ID='face.howdy'
EXT="${OMARCHY_MENU_EXTENSION:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}"
ROW_ID='setup.security.face-howdy'

MODE=open
case "${1:-}" in
  --remove|--uninstall)
    MODE=remove
    ;;
  -h|--help)
    echo "Usage: omarchy-howdy-menu-entry [--remove]"
    exit 0
    ;;
esac

if [[ $MODE == open ]]; then
  if omarchy plugin list 2>/dev/null | grep -q "^$PLUGIN_ID.*enabled\|enabled.*$PLUGIN_ID"; then
    exec omarchy-shell shell toggle "$PLUGIN_ID"
  fi
  # Plugin is disabled or gone: fall through and remove the stale row.
fi

[[ -f $EXT ]] || exit 0
line=$(grep -n "\"$ROW_ID\"" "$EXT" | head -n1 | cut -d: -f1 || true)
[[ -n $line ]] || exit 0

rowline=$(sed -n "${line}p" "$EXT")
if [[ $rowline != *omarchy-howdy-menu-entry* && $rowline != *"toggle face.howdy"* ]]; then
  exit 0
fi

sed -i "${line}d" "$EXT"

last_entry=1
if (( line <= $(wc -l < "$EXT") )); then
  after=$(sed -n "${line}p" "$EXT")
  trimmed_after=$(printf '%s' "$after" | sed 's@^[[:space:]]*@@')
  if [[ -n $trimmed_after && ${trimmed_after:0:1} != "}" && ${trimmed_after:0:1} != "/" ]]; then
    last_entry=0
  fi
fi

if (( last_entry )); then
  prev=$((line - 1))
  while (( prev > 0 )); do
    content=$(sed -n "${prev}p" "$EXT")
    trimmed=$(printf '%s' "$content" | sed 's@^[[:space:]]*@@')
    if [[ -n $trimmed && ${trimmed:0:1} != "/" ]]; then
      break
    fi
    prev=$((prev - 1))
  done
  if (( prev > 0 )); then
    last_trimmed=$(printf '%s' "$(sed -n "${prev}p" "$EXT")" | sed 's@[[:space:]]*$@@')
    if [[ $last_trimmed != "{" && ${last_trimmed: -1} == "," ]]; then
      sed -i "${prev}s/,$//" "$EXT"
    fi
  fi
fi

if [[ $MODE == open ]]; then
  notify-send -a face.howdy "Face Howdy" "Plugin is disabled — entry removed" 2>/dev/null || true
fi
